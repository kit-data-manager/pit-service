FROM eclipse-temurin:21@sha256:3e3c176ffed168beb42c607be9bc1639b466cf00261a0fb04425562c9d0c5c2b AS build-typid
LABEL maintainer="webmaster@datamanager.kit.edu"
LABEL stage=build
RUN mkdir -p /app/
WORKDIR /app/
COPY . .
RUN ./gradlew build -x test --stacktrace && \
    cp build/libs/TypedPIDMaker*.jar ./


# Create a clean, minimal image
FROM eclipse-temurin:21@sha256:3e3c176ffed168beb42c607be9bc1639b466cf00261a0fb04425562c9d0c5c2b AS typed-pid-maker
LABEL maintainer="webmaster@datamanager.kit.edu"
LABEL stage=run

ENV REPO_PORT=8090

RUN mkdir -p /app/config && mkdir -p /data/
COPY --from=build-typid /app/TypedPIDMaker*.jar /app/TypedPIDMaker.jar
COPY config/application-docker.properties /app/config/application-default.properties
EXPOSE ${REPO_PORT}
WORKDIR /app/
ENTRYPOINT ["./TypedPIDMaker.jar"]
